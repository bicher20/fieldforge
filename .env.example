# Copie ce fichier en .env et remplis de vraies valeurs avant tout déploiement.
# docker-compose le lit automatiquement s'il s'appelle exactement ".env".

# Secret de signature des tokens JWT — génère une valeur aléatoire, par exemple :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-random-secret

# Compte admin créé automatiquement au premier démarrage.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Mot de passe de la base Postgres (docker-compose uniquement).
POSTGRES_PASSWORD=change-me

# Port HTTP exposé sur l'hôte (VPS).
APP_PORT=8000

# Intégration OPTIONNELLE : optimisation de tournée via le Scheduler API Nomadia
# (self-service — https://scheduler-json-api.readme.io). Laisse NOMADIA_API_KEY
# vide pour désactiver proprement la fonction ; FieldForge reste 100% utilisable
# sans elle.
NOMADIA_BASE_URL=https://scheduler-api-test.nomadia-app.com
NOMADIA_API_KEY=

# URL du frontend Next.js (web/) vers l'API FastAPI — interne au réseau docker-compose.
FIELDFORGE_API_URL=http://app:8000
WEB_PORT=3000

# Derrière un reverse proxy/tunnel dont le host public diffère du host interne
# (ex. GitHub Codespaces), Next.js bloque les Server Actions par sécurité (CSRF)
# tant que le host public n'est pas listé ici. Liste séparée par des virgules,
# jokers autorisés (ex. "*.app.github.dev"). Laisse vide en déploiement classique
# derrière Nginx/Caddy qui transmet correctement X-Forwarded-Host.
SERVER_ACTIONS_ALLOWED_ORIGINS=
